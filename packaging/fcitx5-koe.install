post_install() {
  cat <<'EOF'
fcitx5-koe installed. Next steps:

1. Backend. Either run a local server or use a cloud API.

   Local (Qwen3-ASR, ~2.5 GB, needs llama-server with CUDA):
     mkdir -p ~/.local/share/koe/models
     cd ~/.local/share/koe/models
     for f in Qwen3-ASR-1.7B-Q8_0.gguf mmproj-Qwen3-ASR-1.7B-Q8_0.gguf; do
       curl -fL -o "$f" \
         "https://huggingface.co/ggml-org/Qwen3-ASR-1.7B-GGUF/resolve/main/$f"
     done
     systemctl --user enable --now koe-llama-server.service

   Cloud: skip the above and point ~/.config/koe/config.toml
   at a cloud profile instead.

2. Config: copy /usr/share/doc/fcitx5-koe/config.example.toml to
   ~/.config/koe/config.toml and pick the active profile.

3. Services:
   systemctl --user enable --now koe-daemon.service

4. Log out and back in so fcitx5 loads the addon,
   then hold Right Ctrl in a text field and speak.
EOF
}

post_upgrade() {
  post_install
}
