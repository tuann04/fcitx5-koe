# Maintainer: tuann04 <voanhtuan2004@gmail.com>
pkgname=fcitx5-koe
pkgver=0.2.0
pkgrel=1
pkgdesc='Hold-to-talk speech-to-text addon for fcitx5'
arch=('x86_64')
url='https://github.com/tuann04/fcitx5-koe'
license=('MIT')
depends=('fcitx5' 'pipewire' 'curl' 'nlohmann-json' 'tomlplusplus' 'sherpa-onnx')
makedepends=('cmake' 'extra-cmake-modules' 'pkgconf' 'gcc' 'make')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('7a7793b7dc0e1354f06f7c6718a3f2a0c6436677181774f1b625705565ae5277')
install=$pkgname.install

build() {
  cmake -B build -S "$pkgname-$pkgver" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
