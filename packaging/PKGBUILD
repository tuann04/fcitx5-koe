# Maintainer: tuann04 <voanhtuan2004@gmail.com>
pkgname=fcitx5-koe
pkgver=0.1.0
pkgrel=1
pkgdesc='Hold-to-talk speech-to-text addon for fcitx5'
arch=('x86_64')
url='https://github.com/tuann04/fcitx5-koe'
license=('MIT')
depends=('fcitx5' 'pipewire' 'curl' 'nlohmann-json' 'tomlplusplus')
makedepends=('cmake' 'extra-cmake-modules' 'pkgconf')
optdepends=('llama.cpp: local speech recognition backend (llama-server)')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# Maintainer: set the real hash on release, e.g. with `makepkg -g`.
sha256sums=('SKIP')
install=$pkgname.install

build() {
  cmake -B build -S "$pkgname-$pkgver" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
